# --- GitLab (the projects repoguard checks) ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxx           # scope: api. Jenkins also uses it to clone.
GITLAB_WEBHOOK_SECRET=change-me
REPOGUARD_EXECUTOR_REPOS=my-group/*    # which projects get CI builds
REPOGUARD_SWEEP_INTERVAL=0

# --- Jenkins (created for you) ---
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-too

# --- SonarQube: run deploy/stack/init-sonar.sh once, paste the token here, then `up -d` again ---
SONAR_TOKEN=

# Build backend: jenkins (default in this stack) or docker
# REPOGUARD_EXECUTOR=docker
