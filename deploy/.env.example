# --- service ---
REPOGUARD_ADDR=:47474
REPOGUARD_WORKERS=8
REPOGUARD_SWEEP_INTERVAL=6h       # stale/SLA sweep; 0 disables
# REPOGUARD_PUBLIC_URL=https://repoguard.example.com

# --- GitHub (App recommended) ---
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# GITHUB_TOKEN=                    # alternative to an App (bot account PAT)
# GITHUB_API_URL=https://ghe.example.com/api/v3   # GitHub Enterprise Server

# --- GitLab ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=                      # bot user / group access token, scope: api, role: Developer
GITLAB_WEBHOOK_SECRET=change-me

# --- AI review (optional) ---
ANTHROPIC_API_KEY=
REPOGUARD_AI_MODEL=claude-opus-5-5
REPOGUARD_AI_EFFORT=high

# --- Executor (optional): build MRs when the project's own CI is disabled ---
# REPOGUARD_EXECUTOR=docker
# REPOGUARD_EXECUTOR_REPOS=mygroup/*,other/app      # REQUIRED allow-list
# REPOGUARD_EXECUTOR_IMAGE=ghcr.io/dpvinh30092005/repoguard-ci:1
# REPOGUARD_EXECUTOR_CPUS=2
# REPOGUARD_EXECUTOR_MEMORY=4g
# REPOGUARD_EXECUTOR_TIMEOUT=20m
# REPOGUARD_EXECUTOR_CONCURRENCY=2
# REPOGUARD_EXECUTOR_NETWORK=bridge                 # "none" if builds need no downloads
# REPOGUARD_EXECUTOR_RUNTIME=runsc                  # gVisor, if installed
